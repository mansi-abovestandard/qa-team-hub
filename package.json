{
  "name": "qa-team-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Team QA tool: projects, checklists from templates, test rounds, bugs and emailed reports",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "create-admin": "node --disable-warning=ExperimentalWarning server/cli/create-admin.js",
    "run-checks": "node --disable-warning=ExperimentalWarning server/cli/run-checks.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
