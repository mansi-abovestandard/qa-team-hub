# Copy to .env (git-ignored)
PORT=4400
# Set to true when the app is served over https (cookie is then marked Secure)
COOKIE_SECURE=false
# Where the SQLite database file lives
DATABASE_FILE=./data/qa-hub.db

# Email (SMTP) used for report emails. Recipients are set per project in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
REPORT_FROM=qa@abovestandard.dk
